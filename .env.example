# wame configuration (copy to .env or ~/.wame/.env)

# HTTP/SSE daemon port (default: 3026)
PORT=3026

# Bind host (empty = dual-stack loopback 127.0.0.1 and [::1])
# HOST=127.0.0.1

# Persistent store directory for WhatsApp session, messages DB, and downloaded media
# WAME_STORE_DIR=~/.wame/store

# Comma-separated browser Origins allowed to access /mcp, /sse, and /health
# CLI tools send no Origin header and are always allowed.
# WAME_ALLOWED_ORIGINS=
